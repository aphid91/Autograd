#version 430

// Turn the compaction's atomic counts into indirect dispatch group counts.
// One thread, once per tick, after the compaction's barrier.
//
// Why this cannot be folded into the compaction
// ---------------------------------------------
// The group count is `ceil(count / LOCAL)`, and the count is not final until
// every claim has landed -- which is the end of the compaction dispatch, not
// a point any thread inside it can observe. A thread writing the group count
// from its own view of the atomic would write whatever the count happened to
// be when it looked, so the tick kernels would be dispatched over a prefix of
// the awake set and the rest would silently not run.
//
// That is the quiet, cumulative failure this layer's whole soundness burden is
// about: nothing is corrupted on the tick it happens, one entity just fails to
// move, and the error compounds for a hundred ticks until it reads as a logic
// bug in the player's circuit. So the arithmetic goes in its own dispatch
// after its own barrier, which is the only place the count is knowably
// complete.

layout(local_size_x = 1) in;

layout(std430, binding = 22) buffer Args { uvec4 args[]; };

const int ARG_SEG = 0;
const int ARG_GATE = 1;

//: Must equal `compute.LOCAL_SIZE`; pinned by tests/test_glsl.py.
const uint LOCAL = 64u;

void main() {
    uint seg = args[ARG_SEG].w;
    uint gate = args[ARG_GATE].w;
    // `max(1)` so an empty awake set is still a valid dispatch: a zero group
    // count is legal but the kernels' own bounds check is what makes it a
    // no-op, and a 0-group dispatch is a driver edge case not worth relying
    // on. One group of 64 threads all returning immediately is free.
    args[ARG_SEG] = uvec4(max((seg + LOCAL - 1u) / LOCAL, 1u), 1u, 1u, seg);
    args[ARG_GATE] = uvec4(max((gate + LOCAL - 1u) / LOCAL, 1u), 1u, 1u, gate);
}
