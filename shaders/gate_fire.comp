#version 430

// The structure phase, as a compute dispatch: one thread per gate.
//
// This is the GPU form of GateSim._fire_admitted(). Every gate that can
// fire, fires: it reads its input channels, clears the ones the machine
// used, and puts results in its output waiting zones. It touches no belt
// state at all, which is what makes the whole phase order-independent and so
// expressible as one dispatch with no synchronisation inside it.
//
// Why there is no prefilter here
// ------------------------------
// The CPU grew a vectorised prefilter and two tiers of gate sleep because a
// per-gate Python path cost ~48k calls a tick to reach "no". Neither is
// ported, and that is deliberate rather than pending. A thread that decides
// "I cannot fire" costs a few ALU ops and one coalesced read; compacting the
// survivors costs a scan, an indirection, and a round of bookkeeping that the
// CPU already measured as a *net loss* even when it was saving real work.
// Every gate is visited and most do nothing, which is the right trade when
// the visit is this cheap.
//
// Branching is likewise not avoided. The opcode switch below is a few
// predicated ALU ops; this hardware is bottlenecked on memory, and the
// layout (gate-dense SoA, see core/gate_state.py) is where the attention
// went instead.
//
// What this does NOT do
// ---------------------
// `inputs_ready()` and `consumed()` are overridable in Python, and Merge
// overrides both -- its readiness depends on the *values* held, not on
// occupancy, and it consumes only the lane its control selects. That is what
// FIRE_SELECT names. Those types are flagged in the geometry block and left
// for the host, exactly as the CPU prefilter always admitted them rather
// than deciding them. A kernel that guessed would silently eat a loaded lane.

#include "common.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 4) buffer InValue  { float in_value[]; };
layout(std430, binding = 5) buffer InHeld   { float in_held[]; };
layout(std430, binding = 6) buffer OutValue { float out_value[]; };
layout(std430, binding = 7) buffer OutHeld  { float out_held[]; };

// Per-gate geometry, resolved once per edit on the host. Four ints:
//   .x  type id
//   .y  input channel count
//   .z  output channel count
//   .w  flags, below
//
// The drains mask rides in the flags word rather than in an array of its
// own: it is MAX_CHANNELS bits, the word has room, and a gate that reads its
// geometry needs the mask in the same breath -- one fetch instead of two.
//
// **Two ivec4s per gate**, the second carrying the select rule:
//   [1].x  control channel   [1].y  lane a positive control names
//   [1].z  lane it names otherwise   [1].w  reserved
// Only meaningful with FLAG_SELECT set. A second vector rather than more
// bits in the flags word because these are channel *indices*, not a mask,
// and std430 pads an ivec4 array stride anyway -- the same reasoning that
// grew the segment record from one vector to two.
layout(std430, binding = 8) buffer Geom { ivec4 geom[]; };

//: Slots per gate in `geom`. Mirrored by core/gate_device.py.
const int GEOM_STRIDE = 2;

// The per-instance constant OP_CONST reads (a Source's emit value), one per
// gate slot. A separate array rather than a column of `geom` because it is a
// float and geom is ints -- mixing them would mean a bitcast per read for
// one value most gates never use.
layout(std430, binding = 9) buffer Konst { float konst[]; };

// --- the sleep layer (see core/sleep_device.py) -------------------------
//
// `awake_gate` is the compacted list of gate slots this dispatch covers and
// `args[1].w` is how many it holds, both produced on the device. The thread
// count is the awake count: an early return would still launch the warp.
// One mailbox for both families; see SLEEP_WAKE_BINDING in render/compute.py.
layout(std430, binding = 16) buffer Wake      { int wake[]; };
layout(std430, binding = 19) buffer AwakeGate { int awake_gate[]; };
layout(std430, binding = 22) buffer Args      { uvec4 args[]; };
//: Each gate's adjacency, CSR, shared with sleep_compact.comp. A gate that
//: fires has to wake whoever it just fed, and its neighbours are here --
//: derived once per edit by core/sleep_graph.py so this kernel and the
//: compaction cannot disagree about who is adjacent to whom.
layout(std430, binding = 20) buffer GateNbr   { int gate_nbr[]; };
layout(std430, binding = 21) buffer GateNbrAt { int gate_nbr_at[]; };

//: Entity row per gate slot, so the sleep flag can be published into the row
//: the *renderer* reads. The kernel works in slot space throughout (that is
//: the whole point of the gate-dense SoA mirror); this is the one place it
//: needs the row back, and translating here beats the renderer learning about
//: slots.
layout(std430, binding = 25) buffer GateRows { int gate_rows[]; };

uniform int gate_count;
//: The stamp a wake must carry to be honoured next tick.
uniform int wake_epoch;
//: 0 when the sleep layer is bypassed: dispatch over every gate, post no
//: wakes, publish no flag. The player's A/B switch.
uniform int sleep_on;
//: Start of the gate region in `wake`.
uniform int wake_gate_base;

//: Publish one gate's sleep state into its entity row, for the SLEEP_DEBUG
//: overlay. Writes the same `F_ASLEEP` field the CPU's `_publish_sleep()`
//: does, so the overlay needs no GPU-specific branch and `gate_asleep()` in
//: common.glsl keeps working unchanged.
void gate_set_asleep(uint slot, bool asleep) {
    int row = gate_rows[slot];
    if (row < 0) return;
    ent[row * ENTITY_STRIDE + F_ASLEEP] = asleep ? 1.0 : 0.0;
}

//: Flag bits in `geom[].w`. Mirrored by core/gate_device.py, and pinned
//: against it by tests/test_glsl.py -- these are a layout contract between
//: two files exactly as the segment record's fields are.
const int FLAG_HOST_DECIDES = 1;   // the kernel cannot express this type
const int FLAG_FIRE_ANY = 2;       // one fed channel is enough (Sink's rule)
const int FLAG_SELECT = 4;         // readiness/consumption follow a control
const int FLAG_DRAIN_SHIFT = 8;    // the drains mask starts here

//: Does output channel `c` of this gate have somewhere to send a result?
bool gate_drains(int flags, int c) {
    return (flags & (1 << (FLAG_DRAIN_SHIFT + c))) != 0;
}

//: Everything one hop from this gate, armed for the coming tick. Called when
//: the gate actually changed something another entity reads -- it filled a
//: waiting zone (so a downstream run or gate can move) or cleared an input
//: lane (so an upstream producer blocked on it can deliver).
//:
//: **Coarse on purpose: both directions, every neighbour.** The precise
//: version would wake only the entity on the face whose channel changed, and
//: would need this kernel to resolve a channel back to a neighbour -- a
//: second copy of the port geometry, in GLSL, which is the duplication that
//: has twice made the two sides disagree here. A gate has a handful of
//: neighbours, so the cost of waking all of them is a handful of stores,
//: against a missed wake that fails silently and compounds for a hundred
//: ticks. The asymmetry decides it.
void wake_neighbours(int slot) {
    int lo = gate_nbr_at[slot];
    int hi = gate_nbr_at[slot + 1];
    for (int k = lo; k < hi; ++k) {
        int entry = gate_nbr[k];
        if (entry < 0) wake[wake_gate_base + ~entry] = wake_epoch;
        else wake[entry] = wake_epoch;
    }
}

// Try to fire one gate. Returns true iff it did.
//
// **Split out of `main()` so the sleep decision has exactly one home.** Every
// "I cannot act" exit used to be a bare `return` from main; with sleeping,
// each of those is also a *conclusion about whether to run again*, and the
// two must not drift apart. A `return false` here is a gate that did nothing
// and whose state is therefore unchanged, which is precisely the condition
// for sleeping -- stated once rather than at each of the six exits.
bool try_fire(uint slot) {
    ivec4 g = geom[slot * GEOM_STRIDE];
    ivec4 sel = geom[slot * GEOM_STRIDE + 1];
    int type = g.x;
    int n_in = g.y;
    int n_out = g.z;
    int flags = g.w;

    // A type whose readiness or consumption is value-dependent is the host's
    // business. Returning leaves its row untouched, so the CPU path sees
    // exactly the state it would have seen.
    if ((flags & FLAG_HOST_DECIDES) != 0) return false;

    uint base_in = slot * uint(MAX_CHANNELS);
    uint base_out = slot * uint(MAX_CHANNELS);

    // --- readiness ----------------------------------------------------
    // FIRE_ALL needs every declared channel fed; FIRE_ANY needs one. A type
    // with no inputs is vacuously ready, which is what lets a Source through
    // with no special case -- the same property the Python base class has.
    // A selecting type's readiness is value-dependent: the control must be
    // held, and so must the one lane its *sign* names. Neither FIRE_ALL
    // (which would deadlock whenever the unused lane is empty) nor FIRE_ANY
    // (which would fire with no control at all) expresses that -- see
    // `Entity.SELECT_RULE`, which is the single declaration this and the
    // consumption below both read.
    int sel_lane = -1;
    if ((flags & FLAG_SELECT) != 0) {
        uint ctl = base_in + uint(sel.x);
        if (in_held[ctl] <= 0.0) return false;
        sel_lane = (in_value[ctl] > 0.0) ? sel.y : sel.z;
        if (in_held[base_in + uint(sel_lane)] <= 0.0) return false;
    } else {
        int fed = 0;
        for (int c = 0; c < MAX_CHANNELS; ++c) {
            if (c >= n_in) break;
            if (in_held[base_in + uint(c)] > 0.0) fed++;
        }
        bool strict = (flags & FLAG_FIRE_ANY) == 0;
        bool ready = (n_in == 0) || (strict ? (fed == n_in) : (fed > 0));
        if (!ready) return false;
    }

    // --- back pressure -------------------------------------------------
    // Only a channel with somewhere to send a result can block: a dangling
    // output is a sink in its own right, so waiting on one would stall the
    // machine on a zone nothing will ever drain. `drains` carries that,
    // resolved per edit (see GateState.drains).
    //
    // A generator is the one exception and fills whichever zones are free
    // rather than requiring all of them clear -- otherwise one slow belt
    // would stall every other belt the same Source feeds.
    bool generator = (n_in == 0);
    bool any_free = false;
    for (int c = 0; c < MAX_CHANNELS; ++c) {
        if (c >= n_out) break;
        if (!gate_drains(flags, c)) continue;
        bool free = out_held[base_out + uint(c)] <= 0.0;
        if (free) any_free = true;
        else if (!generator) return false;   // blocked: a drained zone is occupied
    }
    if (generator && !any_free) return false;

    // --- fire -----------------------------------------------------------
    // Gather the inputs first: `consumed` clears them below, and an opcode
    // may read a channel a later one has already cleared.
    float v[MAX_CHANNELS];
    for (int c = 0; c < MAX_CHANNELS; ++c) {
        v[c] = (c < n_in && in_held[base_in + uint(c)] > 0.0)
             ? in_value[base_in + uint(c)] : 0.0;
    }

    float k = konst[slot];
    for (int c = 0; c < MAX_CHANNELS; ++c) {
        if (c >= n_out) break;
        ivec4 op = gate_ops(type, c);
        bool emit;
        // `op.w` is a channel index for OP_MAC/OP_SEL and a *polarity* for
        // OP_GATED, so both readings are passed and the opcode picks. The
        // channel read is safe either way -- a polarity is 0 or 1 and every
        // gate has at least that many lanes -- but passing one value for two
        // meanings is how an opcode set quietly acquires an alias, so the
        // two are spelled apart here exactly as they are in eval_ops().
        float result = gate_eval(op.x, v[op.y], v[op.z], v[op.w], k,
                                 op.w, emit);
        // `emit` false is the machine declining a channel -- Route sending
        // an item down one path and not the other. Not a discard: nothing
        // was produced to begin with, so the zone stays as it was.
        if (!emit) continue;
        // A dangling output destroys what it is sent, rather than filling a
        // zone nobody will drain. The deliberate end of reversible computing
        // here; see core/gates.py.
        if (!gate_drains(flags, c)) continue;
        // A generator writes only the free zones it found; a consuming gate
        // reached here only with every drained zone clear.
        if (generator && out_held[base_out + uint(c)] > 0.0) continue;
        out_value[base_out + uint(c)] = result;
        out_held[base_out + uint(c)] = 1.0;
    }

    // --- consume ---------------------------------------------------------
    // The default is every fed channel, which is what every machine but a
    // selecting one wants.
    //
    // **A selecting type consumes the control and the chosen lane only.**
    // The lane it did not select stays loaded -- neither emitted nor
    // destroyed -- until a later tick's control names it. Falling through to
    // the default here would silently eat material the player can see
    // sitting in the machine, which is the single worst bug this kernel
    // could have: no error, no visual artefact, just items quietly vanishing
    // from a Merge.
    if (!generator) {
        if (sel_lane >= 0) {
            uint ctl = base_in + uint(sel.x);
            in_value[ctl] = 0.0;
            in_held[ctl] = 0.0;
            uint lane = base_in + uint(sel_lane);
            in_value[lane] = 0.0;
            in_held[lane] = 0.0;
        } else {
            for (int c = 0; c < MAX_CHANNELS; ++c) {
                if (c >= n_in) break;
                in_value[base_in + uint(c)] = 0.0;
                in_held[base_in + uint(c)] = 0.0;
            }
        }
    }
    return true;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint slot;
    if (sleep_on != 0) {
        // The bound comes from the args buffer, not a uniform: the count is
        // produced by an atomic on the device, and reading it on the host to
        // set a uniform is the per-tick stall residency exists to avoid.
        if (i >= args[1].w) return;
        int s = awake_gate[i];
        if (s < 0 || s >= gate_count) return;
        slot = uint(s);
    } else {
        // The last work group is partly out of range whenever gate_count is
        // not a multiple of 64. One comparison, and without it a thread
        // writes past the end of every buffer bound here.
        if (i >= uint(gate_count)) return;
        slot = i;
    }

    bool fired = try_fire(slot);
    if (sleep_on == 0) return;

    // --- do I need to run again? -----------------------------------------
    //
    // **A gate that fired stays awake and wakes its neighbours.** It changed
    // its own channels, so the same inputs may let it fire again next tick,
    // and it filled a zone or cleared a lane that somebody else is waiting
    // on. Both halves are needed: re-arming alone would leave a downstream
    // consumer asleep on material that has arrived.
    //
    // **A gate that did not fire sleeps**, and the safety of that rests
    // entirely on the mailbox rather than on any predicate here. It could not
    // act from the state it just read, and that state can only change if
    // somebody writes one of its channels -- which is `deliver_direct()`, a
    // belt pop, or a belt accept, *all three of which post a wake*. So "did
    // nothing" is a sound sleep condition without asking why it did nothing,
    // which is what makes this far simpler than the CPU's two tiers: those
    // had to prove a *feeder* was quiet because they had no push edges to
    // rely on.
    //
    // That is also why this needs no equivalent of the CPU's
    // `no_feeder_segment` refusal -- the dominant one there, at 64 of 79. A
    // lane that nothing can ever feed is simply a lane nothing will ever post
    // a wake for, which is correct rather than a case to detect.
    if (fired) {
        wake[wake_gate_base + int(slot)] = wake_epoch;
        wake_neighbours(int(slot));
    } else {
        // **A gate still holding an undelivered result must stay awake, and
        // must keep waking its neighbours.** This was the second missed wake,
        // and it is subtler than the first because the gate genuinely did
        // nothing this tick -- so "did nothing, therefore sleep" looks right.
        //
        // It is not, because a loaded output zone is *work owed to somebody
        // else*. The belt phase drains a zone only when the receiving run is
        // awake, and the run is woken only by its producer -- this gate. So a
        // gate that fired on tick t, had its zone refused, and then slept on
        // t+1 having "done nothing" leaves the zone loaded for ever with
        // nobody left to announce it.
        //
        // Found on every real board at tick 2 (ram.npz segment 16, cpu.npz
        // 43/52/245/530): an empty at-rest run whose producer had a full zone
        // it could no longer advertise. The run and the gate each correctly
        // concluded there was nothing to do, which is the mutual-sleep shape
        // CLAUDE.md names for the CPU scheduler, reached by a different door.
        //
        // Reading `out_held` rather than tracking whether the zone was filled
        // *this* tick, for the same reason the direct-lane clause reads
        // `out_held`: it is a reading of present data rather than a claim
        // about what another pass did.
        ivec4 g = geom[slot * GEOM_STRIDE];
        int n_out = g.z;
        int flags = g.w;
        uint base_out = slot * uint(MAX_CHANNELS);
        bool owes = false;
        for (int c = 0; c < MAX_CHANNELS; ++c) {
            if (c >= n_out) break;
            if (gate_drains(flags, c)
                    && out_held[base_out + uint(c)] > 0.0) {
                owes = true;
            }
        }
        if (owes) {
            wake[wake_gate_base + int(slot)] = wake_epoch;
            wake_neighbours(int(slot));
        }
    }
    // **The overlay flag is published by the compaction, not here** -- see
    // the matching note in belt_tick.comp. "I did not fire" is not "the tick
    // will skip me": a gate that did nothing can be woken by a neighbour's
    // delivery in the same breath, and is then dispatched. Publishing from
    // here reported 270 of 494 gates asleep on cpu.npz while the dispatch
    // covered 355 -- a flag contradicting the mechanism it displays.
    //
    // `sleep_compact.comp` writes it from the compacted set, which *is* the
    // next tick's dispatch list by construction.
}
