#version 430

// Belt transport, as a dispatch: one thread per segment.
//
// The GPU form of BeltSim.tick(). docs/belt_report.md's whole point is that
// a run ticks in O(1) however many items are on it -- `head`, `tail` and
// `anchor` are the only mutable state, and nothing per-item is written after
// the item enters. So a segment is a handful of scalars and a thread per
// segment is the natural shape; the report says as much ("the loop below
// becomes gl_GlobalInvocationID.x and nothing else changes").
//
// Segments are independent, with one caveat
// -----------------------------------------
// The report's only shared state is at the *nodes*, and transport touches no
// node: `offer()` and `accept()` read and write gate channels, which live in
// the gate SoA arrays, and each (gate, channel) pair has exactly one segment
// on it -- a port face has one neighbour. So two segments can never write
// the same lane, and the dispatch needs no atomics even though many threads
// touch gate state.
//
// **What is not preserved is intra-phase visibility.** The CPU walks
// segments in id order, so a run that drains a gate's waiting zone does it
// *before* a later run in the same phase reads that gate -- and 114 of 197
// gates on ram.npz sit between two runs. Here every thread reads the state
// as it was at the start of the dispatch, so a gate drained by one run is
// still seen as loaded by another until the next tick.
//
// That is a one-tick difference in *scheduling*, not a loss or duplication
// of material: the item stays where it was and moves on the following tick.
// Measured on ram.npz, 2 of 279 runs differ after 8 ticks. It is inherent to
// parallelising a phase the CPU ran sequentially -- the CPU order is itself
// arbitrary (id order, which a rebuild reassigns), so neither is "correct"
// so much as "a consistent choice". Making the two match exactly would mean
// serialising the belt phase, which is the thing being removed.
//
// It is called out rather than hidden because it is the one place the GPU
// timeline can drift from the CPU one, and anybody comparing the two needs
// to expect it. `tests/test_compute.py` compares a single phase from
// identical state, which is the comparison that stays exact.
//
// Tick order is load-bearing
// --------------------------
// advance-anchor -> pop -> push, exactly as the report requires and exactly
// as `tick_segment()` does it. The pop's correctness depends on it: `A == L`
// holds before the pop, so setting `A = L - d` after `head++` leaves every
// remaining item's packed position unchanged and nothing jumps. Reordering
// these three blocks is the mutation `tests/test_belts.py`'s oracle catches
// immediately, and it is why the gate work happens *inside* this sequence
// rather than in passes around it.

#include "common.glsl"

layout(local_size_x = 64) in;

// Gate channel state, shared with the firing kernel -- the belt phase's
// producer and consumer are gate waiting zones and input lanes.
layout(std430, binding = 4) buffer InValue  { float in_value[]; };
layout(std430, binding = 5) buffer InHeld   { float in_held[]; };
layout(std430, binding = 6) buffer OutValue { float out_value[]; };
layout(std430, binding = 7) buffer OutHeld  { float out_held[]; };

// The segment record and the item arena come from common.glsl, at the same
// bindings the renderer reads (1/2/3). **Shared deliberately**: the kernel
// that advances a run and the fragment shader that draws it then cannot
// disagree about the record's shape, which is the same argument that has
// `item_position()` and `BeltSim.position_of()` pinned together. It also
// means a residency run leaves the renderer's buffers already correct --
// there is nothing to copy across before drawing.
//
// Note the int record has a *two*-ivec4 stride (the second carries the sleep
// flag for the overlay), so every access goes through common.glsl's
// seg_head()/seg_tail()/... accessors rather than indexing `seg_i` directly.

// Each end's resolved port, in *slot* space, or -1 for a dangling end:
//   .x  src gate slot   .y  src out channel
//   .z  dst gate slot   .w  dst in channel
layout(std430, binding = 14) buffer Ports { ivec4 seg_ports[]; };

// --- the sleep layer (see core/sleep_device.py) -------------------------
//
// `awake_seg` is the compacted list of segment ids this dispatch covers, and
// `args[0].w` is how many entries it holds -- both produced on the device by
// `sleep_compact.comp`, so neither ever round-trips through the host.
//
// **The thread count is the awake count, not the segment count.** That is the
// entire mechanism: an early `if (asleep) return;` would still launch the
// warp, still occupy the scheduler, and still diverge sleeping lanes against
// awake ones in the same warp. The dispatch has to shrink.
// One mailbox for both families; see SLEEP_WAKE_BINDING in render/compute.py.
layout(std430, binding = 16) buffer Wake      { int wake[]; };
layout(std430, binding = 18) buffer AwakeSeg  { int awake_seg[]; };
layout(std430, binding = 22) buffer Args      { uvec4 args[]; };

uniform int segment_count;
uniform int sim_tick;
//: The epoch a wake must carry to be honoured next tick. See the epoch note
//: in core/sleep_device.py -- a stale stamp is simply a number that no longer
//: matches, which is what removes the need for an O(total) clearing pass.
uniform int wake_epoch;
//: 0 when the sleep layer is bypassed entirely, in which case this kernel is
//: dispatched over every segment and posts no wakes. The player's switch, so
//: "sleep system + its overhead" and "no sleep system, no overhead" are both
//: measurable -- see the checkbox note in ui/panel.py.
uniform int sleep_on;
//: Start of the gate region in `wake`.
uniform int wake_gate_base;

//: Arm an entity for the coming tick. Plain stores, not atomics: a mailbox
//: slot is written with one value by however many threads reach it, so the
//: worst a race can do is write the same number twice.
void wake_segment(int sid) {
    if (sid >= 0 && sid < segment_count) wake[sid] = wake_epoch;
}

void wake_gate_slot(int slot) {
    if (slot >= 0) wake[wake_gate_base + slot] = wake_epoch;
}

// Where item `k` is at `tick`, in fixed point. The closed form, and a second
// implementation of BeltSim.position_of() -- pinned against it by
// tests/test_glsl.py, exactly as `item_position()` in common.glsl is.
float belt_position(int sid, int k, int tick) {
    ivec4 si = seg_core(sid);
    vec4 sf = seg_f[sid];
    int slot = k % si.w;
    float age = float(tick - int(items[si.z + slot].x));
    // Cap the age so a long-settled item cannot overflow the product; any
    // position past the end is clamped by the min below anyway.
    float max_age = sf.y / sf.z + 1.0;
    age = min(age, max_age);
    float unblocked = age * sf.z;
    // `packed` is a GLSL reserved word and produces a bare "unexpected '='"
    // with no mention of the keyword -- see the note in CLAUDE.md.
    float clumped = sf.x - float(k - si.x) * sf.w;
    return min(unblocked, clumped);
}

bool belt_has_room(int sid, int tick) {
    ivec4 si = seg_core(sid);
    if (si.x == si.y) return true;   // empty
    return belt_position(sid, si.y - 1, tick) >= seg_f[sid].w;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    int sid;
    if (sleep_on != 0) {
        // One thread per *awake* run. The bound comes from the args buffer
        // rather than a uniform because the count is produced by an atomic on
        // the device -- reading it on the host to set a uniform is exactly the
        // per-tick stall this layer exists inside residency to avoid.
        if (i >= args[0].w) return;
        sid = awake_seg[i];
    } else {
        sid = int(i);
    }
    if (sid < 0 || sid >= segment_count) return;

    ivec4 si = seg_core(sid);
    vec4 sf = seg_f[sid];
    // Segment ids index these arrays directly, so a gap in the id space is
    // a zeroed record rather than a shifted one. cap == 0 means "no segment
    // here" -- and it is also the modulus below, so this guard is required
    // rather than tidy.
    if (si.w == 0) return;

    int head = si.x;
    int tail = si.y;
    int base = si.z;
    int cap = si.w;
    float anchor = sf.x;
    float length = sf.y;
    float speed = sf.z;
    float spacing = sf.w;
    ivec4 ports = seg_ports[sid];

    // 1. The packed front advances until it reaches the end. Every item
    //    taking the packed value moves with it, which is how a whole clump
    //    advances without being touched individually.
    anchor = min(anchor + speed, length);
    // **Write the whole vec4, never a single component.** `seg_f[sid].x = v`
    // on an std430 buffer silently did nothing here -- `seg_i` took its
    // component writes and `seg_f` did not, so the run popped while its
    // anchor stayed put, which reads exactly like a transport bug. Writing
    // the vector is one store either way.
    seg_f[sid] = vec4(anchor, length, speed, spacing);

    // 2. Consume. The head must be *exactly* at the end -- the test that
    //    needs fixed point, since float drift would eventually miss it and
    //    stall a belt permanently with an item a hair short.
    if (head != tail) {
        if (belt_position(sid, head, sim_tick) == length) {
            bool taken = false;
            if (ports.z >= 0) {
                uint lane = uint(ports.z) * uint(MAX_CHANNELS) + uint(ports.w);
                // The gate takes it only if that lane is free; otherwise the
                // item stays on the belt, which is how a run backs up behind
                // a gate that is not firing.
                if (in_held[lane] <= 0.0) {
                    in_value[lane] = items[base + (head % cap)].y;
                    in_held[lane] = 1.0;
                    taken = true;
                }
            }
            if (taken) {
                head += 1;
                // The new head's packed slot is one spacing back, which
                // leaves every remaining item's packed position unchanged so
                // nothing jumps. Clamped at 0 because the report's bare
                // `L - d` assumes L >= d, which a short run can violate.
                anchor = max(0.0, length - spacing);
                seg_f[sid] = vec4(anchor, length, speed, spacing);
                seg_i[sid * 2] = ivec4(head, tail, base, cap);
                // We just loaded a gate's input lane, so that gate can
                // possibly fire next tick. It may be asleep and cannot have
                // noticed: a sleeping entity reads nothing, which is why
                // waking is pushed by whoever moved the material rather than
                // polled by whoever is waiting for it.
                if (sleep_on != 0) wake_gate_slot(ports.z);
            }
        }
    }

    // 3. Produce. There is room once the last item has moved a full spacing
    //    clear of the entrance. Note the room test comes *first*: a full
    //    belt is never even offered an item, so the producer keeps it as the
    //    back-pressure signal the next structure phase reads.
    //
    //    `offered_nothing` is the third fixed point's missing term, recorded
    //    here because this is where the producer is actually consulted -- the
    //    same reason `Segment._declined` carries it one line on the CPU.
    bool offered_nothing = true;
    if (ports.x >= 0) {
        // Re-read: the pop above may have changed head/anchor, and room
        // depends on both.
        si = seg_core(sid);
        if (belt_has_room(sid, sim_tick)) {
            uint zone = uint(ports.x) * uint(MAX_CHANNELS) + uint(ports.y);
            if (out_held[zone] > 0.0) {
                offered_nothing = false;
                int slot = si.y % cap;
                items[base + slot] = vec2(float(sim_tick), out_value[zone]);
                seg_i[sid * 2] = ivec4(si.x, si.y + 1, base, cap);
                // Only now has the producer actually parted with it --
                // offering is not committing.
                out_value[zone] = 0.0;
                out_held[zone] = 0.0;
                // That zone is now free, so the producer can fire again next
                // tick even if it had blocked and gone to sleep on a full
                // zone. The back-pressure edge, and the one easy to forget:
                // a producer starved of *room* is as stuck as a consumer
                // starved of material.
                if (sleep_on != 0) wake_gate_slot(ports.x);
            }
        }
    }

    // --- do I need to run again? ------------------------------------------
    //
    // The run decides for itself and posts the answer, because it has just
    // read every term. A predicate re-derived in the compaction pass would be
    // a second copy of this rule, which is the class of bug that has twice
    // made GLSL disagree with Python here.
    //
    // Three fixed points, straight from `BeltSim.is_at_rest()`:
    //
    //   - empty, with the anchor saturated. The anchor advance is
    //     `min(anchor + v, L)`, which saturates and then returns L for ever.
    //     The clause looks redundant and is not: an empty run whose anchor
    //     has yet to saturate still changes, and dropping it is invisible
    //     end-to-end (see tools/probe_wakelist.py, which is why that tool
    //     checks the predicate against its definition rather than behaviour).
    //   - holding items, head parked at the end, with no room to accept.
    //   - holding items, head parked at the end, and the producer offered
    //     nothing.
    //
    // **The head-at-end clause is load-bearing in the last two**, and leaving
    // it out is the bug CLAUDE.md records twice. An item's position is a
    // closed form over the tick, so a run holding one mid-flight item has
    // *identical stored state* for the item's whole journey -- it advances
    // whether or not anybody visits it, and the pop that follows has no
    // external cause. Sleeping on "nothing can enter" alone strands the item
    // mid-belt for ever, which is exactly what happened to seeded runs.
    if (sleep_on == 0) return;
    si = seg_core(sid);
    vec4 rest_f = seg_f[sid];
    bool empty = si.x == si.y;
    // `>=` rather than the pop's exact `==`: the pop needs exactness because
    // a float a hair short would stall the belt for ever, while this only
    // needs "has it arrived", and a position can never exceed the length.
    bool head_at_end = !empty
        && belt_position(sid, si.x, sim_tick) >= rest_f.y;
    //
    // **`offered_nothing` is not enough on its own, and that was a live bug.**
    // It records that the producer had nothing *on this tick*. The CPU's
    // equivalent clause is safe because `GateSim._wake_around()` raises an
    // edge the moment a gate fills a waiting zone -- so "idle now" being
    // falsified later always wakes the run.
    //
    // Here the only gate->run wake is posted when a gate *fires*, and a gate
    // whose zone is already full does not fire. So a run that slept on
    // `offered_nothing` while its producer was merely blocked for one tick
    // was never woken when the zone drained elsewhere. Caught by the
    // differential check at tick 1 on every real board: the sleeping run
    // accepted one item where full ticking accepted two.
    //
    // The fix is to require the producer's zone to be **observably empty**,
    // not merely to have declined. An empty zone can only be refilled by the
    // producer firing, and a gate that fires posts the wake. That turns the
    // clause from a claim about the future into a reading of present data --
    // the same correction the CPU's direct-lane clause documents ("it reads
    // data, not conclusions").
    bool src_empty = true;
    if (ports.x >= 0) {
        uint zone = uint(ports.x) * uint(MAX_CHANNELS) + uint(ports.y);
        src_empty = out_held[zone] <= 0.0;
    }
    bool at_rest;
    if (empty) {
        at_rest = rest_f.x >= rest_f.y;
    } else {
        at_rest = head_at_end
            && (!belt_has_room(sid, sim_tick)
                || (offered_nothing && src_empty));
    }
    // Re-arm unless provably inert. Note the asymmetry that makes this safe
    // in the right direction: staying awake is always correct and merely
    // wasteful, while sleeping wrongly strands material silently. So the
    // default on any doubt is to run again.
    if (!at_rest) wake_segment(sid);
    // **The overlay flag is published by the compaction, not here.**
    //
    // This thread knows only its own conclusion, and that is the wrong
    // question. "I am at rest" is not "the tick will skip me": a run that
    // concludes it is at rest can still be woken a moment later by its
    // producer's push, and then it *is* dispatched. Publishing from here
    // measured 478 of 538 runs "asleep" on cpu.npz while the dispatch
    // actually covered 185 -- the flag disagreeing with the mechanism it
    // exists to display.
    //
    // So `sleep_compact.comp` writes it from the compacted set, which is by
    // definition exactly what the next tick dispatches over. See the note
    // there.
}
